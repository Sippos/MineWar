# Godot 4+ specific ignores
.godot/
*.translation
export.cfg
export_presets.cfg
*.tmp

# Local experiment / backup noise that should never hit main
tools/sprite_lab/source/dome_material/backups/
_quarantine/
**/upgrade_tree_lab*
**/sprite_lab/**/backups/

# OS / editor
.DS_Store
Thumbs.db
*.swp
*~

# Build artifacts
build/

# Local toolchain: the CI Godot download (75 MB zip + extracted binary) and the
# godot-ai MCP server's per-session script backups. The addons/godot_ai plugin
# itself IS tracked -- project.godot enables it and autoloads its runtime.
.ci/godot/
.ci/godot.zip
.godot-mcp/

# Godot engine class-reference XML, extracted locally for editor tooling.
# These are engine sources, not part of this game.
doc/classes/
modules/*/doc_classes/
platform/*/doc_classes/

# Scratch upload payloads
*.b64

# Dead scratch scene: a single Node whose script (scripts/tools/
# generate_main_menu_background.gd) was never in the repo and no longer exists
# on disk, so exporting it fails resource loading. Nothing loads this scene.
background_generator.tscn
